k3d:
Guides: https://k3d.io/v5.8.3/usage/configfile/
k3d cluster -h or k3d help cluster
k3d cluster (list, start, stop, create [-c config file], delete)
(most commands will be kubectl commands)




Creating cluster:
k3d cluster create acluster -a 2 -s 1  --port '80:80@loadbalancer' -v /opt/nobody:/nobody@agent:0,1
k3d cluster create acluster -a 2 -s 1  --port '80:80@loadbalancer' -v /opt/no:/nosquish@agent:0,1
kubectl taint node k3d-acluster-server-0 node-role.kubernetes.io/control-plane:NoSchedule

apt-get install nfs-kernel-server
sudo systemctl start nfs-kernel-server.service
vi /etc/exports
/kubernetes     172.24.235.162(rw,no_subtree_check,no_root_squash)
sudo exportfs -a


helm repo add nfs-subdir-external-provisioner https://kubernetes-sigs.github.io/nfs-subdir-external-provisioner/
helm install nfs-subdir-external-provisioner nfs-subdir-external-provisioner/nfs-subdir-external-provisioner \
    --set nfs.server=172.24.235.162 \
    --set nfs.path=/kubernetes
creates:
